# Person 3 — Gmail + Slack
# ============================================
# Gmail uses OAuth2 (token.json generated locally, never committed)
GMAIL_CREDENTIALS_PATH=credentials.json

SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

